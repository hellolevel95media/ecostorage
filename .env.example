# ==============================================================================
# SUPABASE CONFIGURATION TEMPLATE
# Copy this file to '.env.local' for local development.
# DO NOT paste real secret keys directly into this file.
# ==============================================================================

# Project Identifiers
NEXT_PUBLIC_SUPABASE_PROJECT_REF=""

# Client API Keys (Safe for Client/Browser)
# The app reads NEXT_PUBLIC_SUPABASE_ANON_KEY — either the legacy JWT anon
# key or the new "publishable" (sb_publishable_...) key works here, Supabase
# accepts both formats for this parameter.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Server/Admin Secrets (NEVER expose to Client/Browser)
# Legacy format: SUPABASE_SERVICE_ROLE_KEY / New format: Secret Key
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=""

# Database Connection Credentials
SUPABASE_DB_PASSWORD=""

# Public site URL (used by sitemap.xml and robots.txt)
NEXT_PUBLIC_SITE_URL="https://www.storagespace.com.sg"

# ==============================================================================
# ADMIN ACCESS ALLOWLIST
# Comma-separated list of the ONLY email addresses allowed into /admin, even
# if they hold a valid Supabase-authenticated session. Required: without this
# set, every signed-in user is locked out of /admin (fails closed on purpose).
# Also go disable "Allow new users to sign up" under Supabase's dashboard at
# Authentication > Providers > Email — this env var is a backstop, not a
# replacement for turning off public sign-up at the source.
# ==============================================================================
ADMIN_ALLOWED_EMAILS=""

# ==============================================================================
# EMAIL (Resend) — inquiry notifications
# Create a free account at resend.com, verify a sending domain, and grab an
# API key. Leave unset to skip email notifications (inquiries still save).
# ==============================================================================
RESEND_API_KEY=""
INQUIRY_NOTIFICATION_EMAIL=""
INQUIRY_NOTIFICATION_FROM=""

# ==============================================================================
# ERROR MONITORING (Sentry)
# Create a free account at sentry.io, create a Next.js project, and copy the
# DSN. Leave unset to skip error reporting entirely (no-op, build unaffected).
# SENTRY_AUTH_TOKEN/ORG/PROJECT are only needed to upload source maps on build.
# ==============================================================================
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# ==============================================================================
# AFFILIATE SYSTEM INTEGRATION (ecostorage-affiliates)
# ==============================================================================
# Base URL of the affiliate app. Local dev runs it on port 3000, so run this
# site on another port (e.g. `npm run dev -- -p 3001`). Production: the
# affiliate app's vercel.app URL.
AFFILIATE_API_URL=http://localhost:3000
# Shared HMAC secret for signed server-to-server calls (lead relay, promo
# validation, affiliate applications). Must be IDENTICAL to
# AFFILIATE_WEBHOOK_SECRET in D:\ecostorage-affiliates\.env.local.
# Server only, never prefix with NEXT_PUBLIC_.
AFFILIATE_WEBHOOK_SECRET=

# --- Cloudflare Turnstile (bot check on contact, calculator, partner forms) ---
# Same widget as the affiliate app; copy both keys from
# D:\ecostorage-affiliates\.env.local.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Referral attribution ---
# Lifetime of the ?ref= cookie in days (business rule: 14).
REFERRAL_COOKIE_DAYS=14